# MiMo provides an OpenAI-compatible Chat Completions endpoint.
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_API_KEY=replace-with-your-local-key
AI_MODEL=mimo-v2.5-pro
AI_TIMEOUT_SECONDS=60

# Local prototype limits.
MAX_INPUT_CHARS=60000
MAX_PDF_BYTES=10485760
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The API expects a user identity from the authenticated gateway.
# Keep this true only for local testing with an unsigned X-User-ID header.
ALLOW_INSECURE_DEV_IDENTITY=true
# Set this in shared/staging/production deployments. The gateway signs the
# X-User-ID value with HMAC-SHA256 and sends the hex digest as X-User-Signature.
USER_ID_SIGNING_SECRET=

# Optional server settings.
HOST=0.0.0.0
PORT=8000
