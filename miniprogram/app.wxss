page {
  background: #f4f7fb;
  color: #102a43;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
}

.muted {
  color: #627d98;
}

.primary-button {
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: #1976d2;
  color: #ffffff;
}

.secondary-button {
  margin-top: 20rpx;
  border-radius: 18rpx;
  background: #d9eaf7;
  color: #102a43;
}

.card-panel {
  padding: 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(16, 42, 67, 0.08);
}

.custom-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding-right: 32rpx;
  padding-left: 32rpx;
  background: rgba(244, 247, 251, 0.96);
}

.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 16rpx;
}

.nav-title-wrap {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.nav-eyebrow {
  color: #1976d2;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.nav-title {
  color: #102a43;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.nav-title-wrap .nav-title {
  margin-top: 2rpx;
}

.nav-action {
  flex-shrink: 0;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  background: transparent;
  color: #1976d2;
  font-size: 26rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.nav-action::after {
  border: 0;
}

.nav-action.muted {
  color: #829ab1;
}

