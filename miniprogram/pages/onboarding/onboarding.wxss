.onboarding-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 48rpx;
  padding-bottom: 52rpx;
  background: #f6f8fb;
}

.onboarding-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-brand {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #102a43;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.skip-text {
  color: #829ab1;
  font-size: 25rpx;
}

.step-indicator {
  display: flex;
  gap: 12rpx;
  margin-top: 68rpx;
}

.step-dot {
  width: 36rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d9e2ec;
}

.step-dot.active {
  width: 72rpx;
  background: #1976d2;
}

.tour-content {
  flex: 1;
  padding-top: 72rpx;
}

.tour-visual {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #e8f3fb;
}

.tour-visual::after {
  position: absolute;
  right: -100rpx;
  bottom: -160rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(25, 118, 210, 0.12);
  content: "";
}

.interactive-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e8f3fb;
}

.interactive-visual::after {
  display: none;
}

.demo-card {
  position: relative;
  z-index: 1;
  width: 480rpx;
  min-height: 218rpx;
  box-sizing: border-box;
  padding: 28rpx 30rpx;
  border: 1rpx solid #d9eaf7;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(16, 42, 67, 0.12);
}

.demo-card-label,
.demo-card-title,
.demo-card-copy,
.demo-card-hint {
  display: block;
}

.demo-card-label {
  color: #1976d2;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.demo-card-title {
  margin-top: 16rpx;
  color: #102a43;
  font-size: 30rpx;
  font-weight: 700;
}

.demo-card-copy {
  margin-top: 10rpx;
  color: #627d98;
  font-size: 22rpx;
  line-height: 1.55;
}

.demo-card-hint {
  margin-top: 16rpx;
  color: #9fb3c8;
  font-size: 20rpx;
}

.gesture-result {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.gesture-result.remembered {
  color: #2f855a;
}

.gesture-result.not-remembered {
  color: #c53030;
}

.gesture-checklist {
  position: absolute;
  right: 28rpx;
  bottom: 22rpx;
  left: 28rpx;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  color: #9fb3c8;
  font-size: 21rpx;
}

.gesture-checklist .checked {
  color: #1976d2;
  font-weight: 700;
}

.demo-swipe-left {
  animation: demo-swipe-left 320ms ease-out;
}

.demo-swipe-right {
  animation: demo-swipe-right 320ms ease-out;
}

.demo-swipe-up {
  animation: demo-swipe-up 320ms ease-out;
}

.demo-swipe-down {
  animation: demo-swipe-down 320ms ease-out;
}

@keyframes demo-swipe-left {
  50% {
    transform: translateX(-60rpx) rotate(-3deg);
    opacity: 0.72;
  }
}

@keyframes demo-swipe-right {
  50% {
    transform: translateX(60rpx) rotate(3deg);
    opacity: 0.72;
  }
}

@keyframes demo-swipe-up {
  50% {
    transform: translateY(-46rpx);
    opacity: 0.72;
  }
}

@keyframes demo-swipe-down {
  50% {
    transform: translateY(46rpx);
    opacity: 0.72;
  }
}

.visual-number {
  position: absolute;
  top: 28rpx;
  left: 30rpx;
  color: #1976d2;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.visual-main {
  position: absolute;
  top: 72rpx;
  left: 48rpx;
  z-index: 1;
  color: #102a43;
  font-size: 86rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.visual-caption {
  position: absolute;
  right: 34rpx;
  bottom: 30rpx;
  z-index: 1;
  color: #486581;
  font-size: 24rpx;
}

.tour-eyebrow {
  display: block;
  margin-top: 48rpx;
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tour-title {
  display: block;
  margin-top: 18rpx;
  color: #102a43;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tour-description {
  display: block;
  margin-top: 22rpx;
  color: #627d98;
  font-size: 28rpx;
  line-height: 1.75;
}

.onboarding-footer {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-top: 48rpx;
}

.back-button,
.next-button {
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.back-button {
  width: 180rpx;
  padding: 0;
  background: #e8eef5;
  color: #486581;
}

.next-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 0 32rpx;
  background: #1976d2;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(25, 118, 210, 0.18);
  text-align: left;
}

.back-button::after,
.next-button::after {
  border: 0;
}

.next-arrow {
  font-size: 36rpx;
  font-weight: 300;
}

.card-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 58rpx;
  color: #829ab1;
  font-size: 23rpx;
}

.card-progress text:last-child {
  color: #1976d2;
  font-weight: 700;
}

.onboarding-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 720rpx;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #d9e2ec;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(16, 42, 67, 0.1);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e8eef5;
  color: #829ab1;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.card-header text:last-child {
  color: #1976d2;
  font-weight: 700;
}

.card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 48rpx 12rpx;
}

.card-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  margin-bottom: 62rpx;
  border-radius: 48rpx;
  background: #e8f3fb;
  color: #1976d2;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-body .tour-eyebrow {
  margin-top: 0;
}

.card-body .tour-title {
  font-size: 44rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8eef5;
  color: #829ab1;
  font-size: 22rpx;
}

.card-footer-arrow {
  color: #1976d2;
  font-size: 34rpx;
}

.onboarding-card.demo-swipe-left,
.onboarding-card.demo-swipe-right,
.onboarding-card.demo-swipe-up,
.onboarding-card.demo-swipe-down {
  animation-fill-mode: forwards;
}

.onboarding-note {
  display: block;
  margin-top: 22rpx;
  color: #9fb3c8;
  font-size: 21rpx;
  text-align: center;
}

