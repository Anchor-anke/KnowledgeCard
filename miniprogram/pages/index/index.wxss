.index-page {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 72rpx;
  padding-bottom: 56rpx;
  background: #f6f8fb;
}

.index-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.index-glow-one {
  top: 120rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(25, 118, 210, 0.08);
}

.index-glow-two {
  bottom: 160rpx;
  left: -180rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(246, 173, 85, 0.08);
}

.brand-lockup,
.index-hero,
.value-list,
.index-footer {
  position: relative;
  z-index: 1;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 26rpx;
  background: #102a43;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 84rpx;
  text-align: center;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-name,
.brand-caption {
  display: block;
}

.brand-name {
  color: #102a43;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-caption {
  margin-top: 6rpx;
  color: #829ab1;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.index-hero {
  margin-top: 150rpx;
}

.hero-eyebrow {
  display: block;
  color: #1976d2;
  font-size: 25rpx;
  font-weight: 600;
}

.title {
  display: block;
  margin-top: 20rpx;
  color: #102a43;
  font-size: 56rpx;
  line-height: 1.25;
  font-weight: 700;
}

.title-accent {
  color: #1976d2;
}

.hero-description {
  display: block;
  max-width: 560rpx;
  margin-top: 28rpx;
  color: #627d98;
  font-size: 28rpx;
  line-height: 1.7;
}

.value-list {
  margin-top: 94rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #d9e2ec;
  border-bottom: 1rpx solid #d9e2ec;
}

.value-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.value-item + .value-item {
  margin-top: 28rpx;
}

.value-number {
  color: #1976d2;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.value-title,
.value-description {
  display: block;
}

.value-title {
  color: #243b53;
  font-size: 27rpx;
  font-weight: 700;
}

.value-description {
  margin-top: 6rpx;
  color: #829ab1;
  font-size: 23rpx;
}

.index-footer {
  margin-top: auto;
  padding-top: 56rpx;
}

.index-start {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 0 28rpx 0 34rpx;
  border: 0;
  border-radius: 20rpx;
  background: #1976d2;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: left;
  box-shadow: 0 14rpx 28rpx rgba(25, 118, 210, 0.2);
}

.index-start::after {
  border: 0;
}

.button-arrow {
  font-size: 38rpx;
  font-weight: 300;
}

.loading-placeholder {
  height: 92rpx;
  border-radius: 20rpx;
  background: #e8eef5;
  color: #829ab1;
  font-size: 26rpx;
  line-height: 92rpx;
  text-align: center;
}

.index-note {
  display: block;
  margin-top: 22rpx;
  color: #9fb3c8;
  font-size: 21rpx;
  text-align: center;
}

